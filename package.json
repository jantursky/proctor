{
  "name": "proctor-docs-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.19", "bun": ">=1.3" },
  "scripts": {
    "dev:docs": "bun run --filter docs dev",
    "build:docs": "bun run --filter docs build",
    "typecheck": "bun run --filter '*' typecheck"
  }
}
